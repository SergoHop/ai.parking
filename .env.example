# --- backend (Go) ---
APP_ENV=dev
HTTP_PORT=8080
DATABASE_URL=postgres://parking:parking@localhost:5432/parking?sslmode=disable
CV_SERVICE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173

# JWT для админа
JWT_SECRET=change_me_to_random_64_chars
JWT_TTL=24h
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me

# общий секрет для внутренних запросов Python -> Go
INTERNAL_TOKEN=change_me_to_random_64_chars

# --- cv (Python) ---
CV_PORT=8000
YOLO_MODEL_PATH=models/yolo11n.pt
VIDEO_DIR=data/videos
SNAPSHOTS_DIR=data/snapshots
FRAMES_DIR=data/frames
MAX_VIDEO_SIZE_MB=500
CONFIDENCE_THRESHOLD=0.4
SAMPLE_FPS=3
MAX_FRAME_WIDTH=1280
OCCUPY_FRAMES=3
FREE_FRAMES=5
FRESHNESS_TTL_SECONDS=15
CAMERA_RECONNECT_SECONDS=5

# умный режим навигации
SMART_ZONE_RADIUS_M=700
PARKING_SEARCH_RADIUS_M=100
NEARBY_SPOTS_COUNT=3
REROUTE_THROTTLE_SECONDS=25

# --- frontend ---
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/ws/live
VITE_YANDEX_MAPS_API_KEY=your_api_key_here

# --- postgres ---
POSTGRES_PORT=5432
POSTGRES_USER=parking
POSTGRES_PASSWORD=parking
POSTGRES_DB=parking
